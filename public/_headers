# Cloudflare Pages response headers

# Sofign (sofign.com) previews this site in a window on its works screen,
# so it may frame it; every other site still can't.
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self' https://sofign.com https://www.sofign.com https://sofign.pages.dev https://*.sofign.pages.dev http://localhost:*
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite fingerprints everything in /assets, so it can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
